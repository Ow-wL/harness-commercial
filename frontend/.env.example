VITE_NAVER_MAP_CLIENT_ID=
# 선택: NAVER Style Editor My Style ID(다크 스타일 harness-a3-blue-dark). 있으면 제품 지도가 GL + 다크 스타일로 뜨고, 실패하면 밝은 지도로 복구한다(8-DK). 값은 커밋하지 않는다
VITE_NAVER_MAP_STYLE_ID=
# 선택: 라이트 테마용 NAVER Style Editor My Style ID(묶음 A). 있으면 라이트 테마에서 GL + 그 스타일, 없으면 NAVER 기본 밝은 지도. 커밋하지 않는다
VITE_NAVER_MAP_LIGHT_STYLE_ID=
# 선택(검수용, 기본 끔): 1이면 스타일 ID 없이도 제품 지도를 GL 벡터 지도로 띄운다(밝은 지도)
VITE_NAVER_MAP_GL=
